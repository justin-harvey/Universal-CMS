# ─────────────────────────────────────────────────────────────────────────
# mail-first-cms environment. Copy to .env and fill in. NEVER commit .env.
# PUBLIC_* values are inlined into the browser bundle (safe: anon key + URL).
# Everything else is server/build-only and must never be PUBLIC_*.
# ─────────────────────────────────────────────────────────────────────────

# --- Public (browser + build): the Studio SPA and canonical URLs ---
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...
PUBLIC_SITE_URL=http://localhost:4321

# --- Build-only: materialize reads published content with the service role ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role...

# --- Netlify Functions only (email pipeline) ---
ANTHROPIC_API_KEY=sk-ant-...           # the email classifier (claude-opus-4-8)
POSTMARK_WEBHOOK_TOKEN=                # shared secret in the inbound webhook URL
POSTMARK_SERVER_TOKEN=                 # outbound: receipts + auto-replies (M4)
UNDO_SIGNING_SECRET=                   # generated by `npm run setup`
SITE_TIMEZONE=America/New_York         # mirrors site.config.ts timezone
REVIEW_THRESHOLD=0.85                  # mirrors site.config.ts email.reviewThreshold
